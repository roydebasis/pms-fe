# Runtime API base URL — shared dev backend (e.g. ngrok), no trailing slash.
VITE_API_BASE_URL=https://example.ngrok-free.app/api/v1

# Contract sync sources (used by `npm run api:sync`).
OPENAPI_STAFF_URL=https://example.ngrok-free.app/docs/api.json
OPENAPI_RENTER_URL=https://example.ngrok-free.app/docs/renter.json
OPENAPI_PLATFORM_URL=https://example.ngrok-free.app/docs/platform.json

# Backend commit that produced the pinned contracts (recorded by api:sync).
BACKEND_COMMIT=f6dec10
